{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "playwright-bdd.config.ts",
    "playwright.config.ts",
    "config/**/*.ts",
    "data/**/*.ts",
    "features/**/*.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "scripts/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts"
  ]
}
