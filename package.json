{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:reports": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; foreach ($path in @('allure-results','allure-report','playwright-report','test-results')) { if (Test-Path $path) { Remove-Item -Recurse -Force $path } }; exit 0\"",
    "clean:allure-report": "powershell -NoProfile -Command \"$ErrorActionPreference='SilentlyContinue'; if (Test-Path 'allure-report') { Remove-Item -Recurse -Force 'allure-report' }; exit 0\"",
    "test": "npx playwright test",
    "test:framework": "node scripts/run-tests.js",
    "test:framework:fresh": "npm run clean:reports && node scripts/run-tests.js",
    "test:bdd": "node scripts/run-tests.js --mode=bdd",
    "test:bdd:fresh": "npm run clean:reports && node scripts/run-tests.js --mode=bdd",
    "test:fresh": "npm run clean:reports && npx playwright test",
    "test:all": "node scripts/run-tests.js",
    "report:playwright": "npx playwright show-report",
    "report:allure:generate": "npm run clean:allure-report && npx allure generate --output allure-report",
    "report:allure:open": "npx allure open allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "show-report:framework": "npx playwright show-report playwright-report/framework",
    "show-report:bdd": "npx playwright show-report playwright-report/bdd",
    "test:cloud": "browserstack-node-sdk playwright test --config=playwright.cloud.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.15.0",
    "allure-playwright": "^3.10.2",
    "browserstack-node-sdk": "^1.66.1",
    "csv-parse": "^7.0.2",
    "playwright-bdd": "^9.2.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "dotenv": "^17.4.2"
  }
}
