{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean:reports": "node -e \"const fs=require('fs'); ['allure-results','allure-report','playwright-report','test-results'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}));\"",
    "clean:allure-report": "node -e \"const fs=require('fs'); fs.rmSync('allure-report',{recursive:true,force:true});\"",
    "test": "npx playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:framework": "node scripts/run-tests.js",
    "test:framework:fresh": "npm run clean:reports && node scripts/run-tests.js",
    "test:bdd": "node scripts/run-tests.js --mode=bdd",
    "test:bdd:fresh": "npm run clean:reports && node scripts/run-tests.js --mode=bdd",
    "test:fresh": "npm run clean:reports && npx playwright test",
    "test:all": "node scripts/run-tests.js",
    "test:smoke": "npm run test:framework -- --env=qa --grep \"@smoke\"",
    "test:regression": "npm run test:framework -- --env=qa --grep \"@regression\" --exclude-tags=@flaky,@quarantine",
    "test:flaky": "npm run test:framework -- --env=qa --grep \"@flaky\"",
    "test:quarantine": "npm run test:framework -- --env=qa --grep \"@quarantine\"",
    "test:flaky:investigate": "npm run test:framework -- --env=qa --grep \"@flaky\" --repeat-each=5",
    "test:critical:strict": "npm run test:framework -- --env=qa --grep \"@critical\" --fail-on-flaky-tests",
    "test:cloud": "browserstack-node-sdk playwright test --config=playwright.cloud.config.ts",
    "report:playwright": "npx playwright show-report",
    "report:allure:generate": "npm run clean:allure-report && npx allure generate --output allure-report",
    "report:allure:open": "npx allure open allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "show-report:framework": "npx playwright show-report playwright-report/framework",
    "show-report:bdd": "npx playwright show-report playwright-report/bdd"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.15.0",
    "allure-playwright": "^3.10.2",
    "browserstack-node-sdk": "^1.66.1",
    "csv-parse": "^7.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "dotenv": "^17.4.2"
  }
}
